# ---------------------------------------------------------------------------
# ForexAI platform - environment contract for docker-compose.yml
#
# Copy to ".env" next to docker-compose.yml and fill in real values.
# Never commit ".env" (it is ignored by .gitignore).
#
# Quick help: run scripts\start-forexai.bat - it checks this file and tells
# you which values are still placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=forexai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me

# --- JWT (issued by the C# API) --------------------------------------------
JWT_ISSUER=ForexAI
JWT_AUDIENCE=ForexAI
JWT_KEY=replace-me-with-a-long-random-string

# --- Market data ------------------------------------------------------------
TWELVE_DATA_API_KEY=replace-me

# --- LLM provider -----------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_NAME=ForexAI
OPENROUTER_SITE_URL=http://localhost

# --- Optional fundamentals sources -----------------------------------------
SOTW_API_KEY=
BUSINESS_QUANT_API_KEY=

# --- CORS -------------------------------------------------------------------
# Origin the dashboard uses to call the C# API directly. The dashboard normally
# reaches the API through the nginx proxy on the same origin, so the default
# below is enough.
CORS_ALLOWED_ORIGIN=http://localhost

# --- Host ports (optional) --------------------------------------------------
# Change only if one of these ports is already taken on this machine.
# The dashboard is the only port other computers can reach; API, AI and
# PostgreSQL bind to 127.0.0.1 (this machine only) inside docker-compose.yml.
DASHBOARD_PORT=80
API_PORT=8080
AI_PORT=8001
POSTGRES_PORT=5434

# --- Security / tuning (optional) ------------------------------------------
# Shared secret between the C# API and the Python service; enables the
# X-API-Key guard on the AI's expensive endpoints. Leave empty to disable
# (the local-development default).
AI_SERVICE_API_KEY=

# TLS mode the AI service uses when connecting to PostgreSQL for the
# fundamentals RAG store. The local Compose database runs without TLS, so
# the default must stay "disable" or every analysis request will fail.
RAG_DB_SSLMODE=disable

# Python service log verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Application version stamped on containers (shown by docker ps / compose ps).
FOREXAI_VERSION=v1.0.0