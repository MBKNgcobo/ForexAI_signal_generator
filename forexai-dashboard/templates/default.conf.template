# Rendered at container start by the official nginx entrypoint
# (envsubst over /etc/nginx/templates). Only *defined* environment
# variables are substituted, so nginx runtime vars ($uri, $host, ...)
# pass through untouched. CSHARP_API_URL defaults to the compose
# service name locally and is overridden on Render.
server {
    listen 80;

    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${CSHARP_API_URL}/api/;

        proxy_http_version 1.1;

        # Upstream may be https (Render edge): send SNI so the host
        # routes correctly. Inert for plain-http upstreams.
        proxy_ssl_server_name on;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeout thresholds from default 60s to 300s (5 minutes)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location /health {
        proxy_pass ${CSHARP_API_URL}/health;

        proxy_set_header Host $host;
    }
}
