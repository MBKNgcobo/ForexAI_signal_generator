# Rendered at container start by the official nginx entrypoint
# (envsubst over /etc/nginx/templates). Only *defined* environment
# variables are substituted, so nginx runtime vars ($uri, $host, ...)
# pass through untouched. CSHARP_API_URL defaults to the compose
# service name locally and is overridden on Render.
server {
    # Render injects PORT (10000 on its free tier) and injects nothing
    # locally, so the Dockerfile pins ENV PORT=80 as the fallback. Without
    # that fallback envsubst renders an empty value and nginx refuses to
    # load the config - which is why the Dockerfile sets it explicitly
    # rather than relying on the variable simply being present.
    listen ${PORT};

    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${CSHARP_API_URL}/api/;

        proxy_http_version 1.1;

        # Upstream may be https (Render edge): send SNI so the host
        # routes correctly. Inert for plain-http upstreams.
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;

        # Host MUST be the upstream's name, never $host.
        #
        # $host is the *dashboard's* hostname. Render's edge routes by Host,
        # so sending forexai-dashboard.onrender.com to the API service sends
        # the request straight back to the dashboard, which proxies it again:
        # an infinite ping-pong. Cloudflare's loop detector eventually killed
        # it with "508 Loop Detected" and every /api/ request failed. Neither
        # Render nor nginx has a hop limit, so the loop would otherwise run
        # indefinitely.
        #
        # $proxy_host is the host from proxy_pass, i.e. the API's own name.
        # The protocol still reports the original browser scheme/address via
        # X-Forwarded-Proto below, which is what the API should trust.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeout thresholds from default 60s to 300s (5 minutes)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Render's liveness probe. Answered by the dashboard itself.
    #
    # This MUST NOT proxy to the API. Render spins free services down after
    # ~15 minutes idle and cold-starts them in ~50 s, so a proxied probe
    # forces the API to wake up and then Render's checker abandons the
    # request before nginx can answer. nginx cannot log a response it never
    # wrote, so it logs 499 (client closed the connection) with 0 bytes sent.
    # Repeating every 10 s that held the dashboard in a restart loop until
    # the deploy timed out.
    #
    # A liveness probe must only assert what this service can vouch for:
    # nginx is up and serving the SPA. Whether the API is reachable is the
    # API's own health check to answer (render.yaml -> forexai-csharp-api,
    # healthCheckPath: /health), not this proxy's.
    location = /health {
        default_type application/json;
        return 200 '{"status":"healthy","service":"forexai-dashboard"}';
    }
}
