# ---------------------------------------------------------------------------
# ForexAI AI Service - environment contract
#
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# --- Market data (required) ------------------------------------------------
# /market-data and the analysis graph raise/return 503 when this is missing.
TWELVE_DATA_API_KEY=replace-me

# --- LLM provider ----------------------------------------------------------
# One of: openrouter | openai | http
LLM_PROVIDER=openrouter

# Used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
# Optional, at most 3 comma-separated fallback models used when the primary
# model is rate-limited or unavailable.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_NAME=ForexAI
OPENROUTER_SITE_URL=http://localhost
# Optional retry tuning (defaults shown).
# OPENROUTER_MAX_ATTEMPTS=3
# OPENROUTER_RETRY_BASE_SECONDS=1.5
# OPENROUTER_RETRY_MAX_SECONDS=8.0
# OPENROUTER_REQUEST_DEADLINE_SECONDS=60.0

# Used when LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=replace-me

# Used when LLM_PROVIDER=http
# LLM_ENDPOINT=http://localhost:9000/generate

# --- Quant ensemble (optional) ---------------------------------------------
# Which trained models to combine, and their relative weights. Names must be
# registered in app/agents/quant_agent.py (random_forest, xgboost,
# logistic_regression). Weights need not sum to 1; they are normalised, and
# malformed entries fall back to the defaults shown below.
# ENSEMBLE_MODELS=random_forest,xgboost,logistic_regression
# ENSEMBLE_WEIGHTS=random_forest=0.4,xgboost=0.4,logistic_regression=0.2

# Quant probability bar for LOW risk and the opposing-quant veto.
# Default 0.50 (validated on EURUSD 15m, 113 days): 0.60 admitted ~0.7
# candidates/day with a negative net, 0.50 admitted ~5.9/day with the only
# profitable net (+0.0471, PF 1.31). Invalid/out-of-range values fall back
# to 0.50. Majority logic is unchanged.
# QUANT_PROBABILITY_THRESHOLD=0.50

# Optional: pre-warm the quant ensemble and the shared market-data service at
# startup so the first real analysis does not pay the one-time cost of loading
# the ~48 MB model artifacts. The hosted Dockerfile sets this to "true"; leave
# unset locally and in tests (the suite must stay cold and fast).
# PREWARM_QUANT=true

# --- Fundamental data sources (optional) -----------------------------------
# World Bank needs no key. The other two are optional but improve coverage.
SOTW_API_KEY=
BUSINESS_QUANT_API_KEY=

# --- RAG store (PostgreSQL) ------------------------------------------------
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=forexai
RAG_DB_USER=postgres
RAG_DB_PASSWORD=replace-me

# TLS for the RAG store. Defaults to "require" because managed Postgres
# (Neon) refuses a plaintext handshake. Set to "disable" only for a local
# `docker compose` Postgres.
# RAG_DB_SSLMODE=require

# Optional: pin one resolved IP to skip AAAA lookups on hosts with no IPv6
# route. Leave unset to let DNS resolve normally.
# RAG_DB_HOSTADDR=

# --- HTTP / security -------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Leave empty to disable CORS entirely (server-to-server usage).
CORS_ALLOWED_ORIGIN=http://localhost

# Optional shared-secret guard. When set, /analysis and /market-data require
# the header "X-API-Key: <value>". When unset the guard is disabled so local
# development keeps working unchanged.
AI_SERVICE_API_KEY=

# --- Batch analysis + webhooks (optional) --------------------------------------
# Max pairs per POST /analysis/batch. Defaults to 10 when unset; invalid or
# non-positive values fall back to 10. Each item's failure is captured
# per-item so one bad pair never fails the whole batch.
# ANALYSIS_BATCH_LIMIT=10

# Hosts permitted as webhook_url targets (comma-separated, case-insensitive).
# Empty means deny-all (localhost stays usable for local receivers). Set this
# to opt into push delivery; otherwise webhook_url is refused server-side.
#
# An entry may be a WILDCARD, written ".example.com" or "*.example.com", to
# cover every subdomain plus the bare domain. This exists for ephemeral
# receivers whose hostname cannot be listed: a Cloudflare quick tunnel is a
# new random subdomain on every restart. Bare entries stay exact, and "*"
# on its own matches nothing.
# WEBHOOK_ALLOWLIST=hooks.example.com
# WEBHOOK_ALLOWLIST=.trycloudflare.com

# Per-request timeout for webhook delivery, in seconds (default 3.0).
# Raise it when the receiver is behind a tunnel or on a slow link.
# Non-numeric, zero and negative values fall back to the default.
# WEBHOOK_TIMEOUT_SECONDS=8

# --- Market data channel --------------------------------------------------------
# Which provider serves candles to agents and GET /market-data:
#   twelve (default) - Twelve Data cloud API (needs TWELVE_DATA_API_KEY)
#   mt5              - local MetaTrader 5 terminal via IPC (needs MT5_* below;
#                      the Python service must run on this Windows machine)
# MARKET_DATA_PROVIDER=twelve

# --- MetaTrader 5 broker (Windows-only, Phases 1-4) -----------------------------
# Local MT5 terminal IPC. MT5_PATH points at terminal64.exe; LOGIN/PASSWORD/
# SERVER are your DEMO account credentials (never commit real values).
# The MetaTrader5 package is Windows-only and pinned with a platform marker
# in requirements.txt so Linux/Docker builds skip it.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_TIMEOUT_SECONDS=60

# Trade execution safety switch (Phase 3+). Default is DRY-RUN: order
# payloads are built and logged but NEVER sent. Set to "false" only on
# the demo account after scripts/check_mt5_orders.py output looks right.
# MT5_DRY_RUN=true

# Signal bridge (scripts/run_signal_bridge.py): lot size per signal.
# MT5_SIGNAL_VOLUME=0.01

# Shared secret for the bridge's /signal endpoint (?token=...). Required
# whenever the bridge is reachable beyond localhost (e.g. a cloudflared
# tunnel). Generate a long random value; never commit the real one.
# BRIDGE_TOKEN=

# --- Logging / observability (optional) --------------------------------------
# LOG_FORMAT=text renders human-readable lines (default). Set to "json" for
# structured one-object-per-line logs with request_id for aggregation.
# LOG_FORMAT=text

# Optional log level: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
