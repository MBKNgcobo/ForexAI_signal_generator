{
  "ConnectionStrings": {
    // No credentials live in source control. Supply the full connection
    // string via the ConnectionStrings__ForexAiDatabase environment
    // variable (docker-compose.yml sets it) or `dotnet user-secrets` for
    // local development, e.g.
    // Host=localhost;Port=5434;Database=forexai;Username=postgres;Password=<password>
    "ForexAiDatabase": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Issuer": "ForexAI",
    "Audience": "ForexAI.Client",
    // Required at runtime for issuing/validating tokens. Set via the
    // Jwt__Key environment variable (docker-compose.yml) or user-secrets.
    // Must be at least 32 bytes.
    "Key": ""
  },

  "DevelopmentUser": {
    "UserId": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
  },

  "PythonApi": {
    "BaseUrl": "http://127.0.0.1:8000"
  },

  "AllowedHosts": "*"
}