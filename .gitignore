# ===========================================================================
# ForexAI platform — repository-wide ignores.
# Sub-projects keep their own .gitignore (ForexAI/, forexai-dashboard/,
# forexai-ai/); this file covers the root and anything not owned by one of
# them.
# ===========================================================================

# --- Secrets ----------------------------------------------------------------
# Root-level ".env" holds docker-compose interpolation values (DB password,
# JWT signing key, provider API keys). Never commit it.
.env
.env.*
!.env.example

# --- Python (root-level caches; forexai-ai/ has its own) -------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Node / frontend (forexai-dashboard/ has its own) ----------------------
node_modules/
dist/
dist-ssr/
*.local

# --- .NET / Visual Studio (ForexAI/ has the full VS template list) ---------
.vs/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# --- Generated artifacts ---------------------------------------------------
# Large, environment-specific blobs: datasets, trained models, backups.
*.joblib
forexai-ai/data/**
!forexai-ai/data/.gitkeep
backups/
*.log

# --- Stray scratch files at the repo root ----------------------------------
# Local editor dumps with no stable location/name.
/app.tsx file and app.ts and program.cs
/package-lock.json
