# ------------------------------------------------------------------
# ForexAI platform — portfolio environment contract (MOCK VALUES ONLY)
# Copy to ".env" at the repo root and fill in real values. Never commit ".env".
# ------------------------------------------------------------------

# --- PostgreSQL (compose service "postgres", host port 5434) ---
POSTGRES_DB=forexai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres-password
# URL-encoded copy of the password for DATABASE_URL (encoding is NOT automatic).
DATABASE_PASSWORD_URLENCODED=changeme-postgres-password
DATABASE_URL=postgresql://postgres:changeme-postgres-password@localhost:5434/forexai

# --- .NET API ---
# EF Core connection string (compose overrides with Host=postgres).
ConnectionStrings__ForexAiDatabase=Host=localhost;Port=5434;Database=forexai;Username=postgres;Password=changeme-postgres-password
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# --- JWT (issued by the C# API, consumed by dashboard/clients) ---
JWT_ISSUER=ForexAI
JWT_AUDIENCE=ForexAI
JWT_KEY=changeme-replace-with-a-long-random-string-min-32-chars

# --- Market data (Twelve Data) ---
TWELVE_DATA_API_KEY=changeme-twelve-data-key

# --- LLM provider: openrouter | openai | http ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=changeme-openrouter-key
OPENROUTER_MODEL=openrouter/example-model:free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_NAME=ForexAI
OPENROUTER_SITE_URL=http://localhost
# Optional retry tuning:
# OPENROUTER_MAX_ATTEMPTS=3
# OPENROUTER_RETRY_BASE_SECONDS=1.5
# OPENROUTER_RETRY_MAX_SECONDS=8.0
# OPENROUTER_REQUEST_DEADLINE_SECONDS=60.0
# OPENAI_API_KEY=
# OPENAI_MODEL=
# LLM_ENDPOINT=http://localhost:9000/generate

# --- RAG store (PostgreSQL, used by the Python AI service) ---
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=forexai
RAG_DB_USER=postgres
RAG_DB_PASSWORD=changeme-postgres-password

# --- Optional fundamentals sources (World Bank needs no key) ---
SOTW_API_KEY=
BUSINESS_QUANT_API_KEY=

# --- Service-to-service guard (Python AI service) ---
# When set, /analysis and /market-data require header "X-API-Key: <value>".
AI_SERVICE_API_KEY=

# --- CORS ---
# Origin the dashboard uses to call the C# API. Empty disables CORS.
CORS_ALLOWED_ORIGIN=http://localhost

# --- Logging / misc ---
LOG_LEVEL=INFO
DEBUG=false
